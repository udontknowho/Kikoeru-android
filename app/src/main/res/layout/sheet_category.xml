<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="18dp">

    <TextView
            style="@style/Theme.Kikoeru.SettingsGroup"
            android:paddingStart="8dp"
            android:text="@string/category"/>

    <LinearLayout style="@style/Theme.Kikoeru.SettingsCard">

        <LinearLayout
                android:id="@+id/categoryVa"
                style="@style/Theme.Kikoeru.SettingsRow">

            <ImageView
                    style="@style/Theme.Kikoeru.SettingsRowIcon"
                    android:contentDescription="@string/va_voicer"
                    android:src="@drawable/ic_baseline_mic_24"/>

            <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                <TextView
                        style="@style/Theme.Kikoeru.SettingsRowTitle"
                        android:text="@string/va_voicer"/>
            </LinearLayout>

            <TextView
                    style="@style/Theme.Kikoeru.SettingsRowArrow"
                    android:text="&#8250;"/>
        </LinearLayout>

        <View style="@style/Theme.Kikoeru.SettingsDivider"/>

        <LinearLayout
                android:id="@+id/categoryTag"
                style="@style/Theme.Kikoeru.SettingsRow">

            <ImageView
                    style="@style/Theme.Kikoeru.SettingsRowIcon"
                    android:contentDescription="@string/tag"
                    android:src="@drawable/ic_baseline_local_offer_24"/>

            <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                <TextView
                        style="@style/Theme.Kikoeru.SettingsRowTitle"
                        android:text="@string/tag"/>
            </LinearLayout>

            <TextView
                    style="@style/Theme.Kikoeru.SettingsRowArrow"
                    android:text="&#8250;"/>
        </LinearLayout>

        <View style="@style/Theme.Kikoeru.SettingsDivider"/>

        <LinearLayout
                android:id="@+id/categoryCircles"
                style="@style/Theme.Kikoeru.SettingsRow">

            <ImageView
                    style="@style/Theme.Kikoeru.SettingsRowIcon"
                    android:contentDescription="@string/circles"
                    android:src="@drawable/ic_baseline_people_24"/>

            <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                <TextView
                        style="@style/Theme.Kikoeru.SettingsRowTitle"
                        android:text="@string/circles"/>
            </LinearLayout>

            <TextView
                    style="@style/Theme.Kikoeru.SettingsRowArrow"
                    android:text="&#8250;"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
