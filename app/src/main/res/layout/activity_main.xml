<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WorksActivity">

    <com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent"
                                                     android:layout_height="wrap_content"
                                                     app:layout_constraintStart_toStartOf="parent"
                                                     app:layout_constraintEnd_toEndOf="parent"
                                                     app:layout_constraintTop_toTopOf="parent"
                                                     android:background="@color/screen_bg"
                                                     android:id="@+id/appBarLayout">
        <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/Theme.Kikoeru.Toolbar"
                />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 收藏 tab 的状态筛选（只在该 tab 显示） -->
    <HorizontalScrollView
            android:id="@+id/chipBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:scrollbars="none"
            android:background="@color/screen_bg"
            app:layout_constraintTop_toBottomOf="@+id/appBarLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="true">
            <com.google.android.material.chip.Chip
                    android:id="@+id/chipReview"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/review"/>
            <com.google.android.material.chip.Chip
                    android:id="@+id/chipMarked"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/marked"/>
            <com.google.android.material.chip.Chip
                    android:id="@+id/chipListening"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/listening"/>
            <com.google.android.material.chip.Chip
                    android:id="@+id/chipListened"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/listened"/>
            <com.google.android.material.chip.Chip
                    android:id="@+id/chipReplay"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/replay"/>
            <com.google.android.material.chip.Chip
                    android:id="@+id/chipPostponed"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/postponed"/>
            <com.google.android.material.chip.Chip
                    android:id="@+id/chipLocal"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/local_works"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- 列表（下拉刷新 = 换一批：换一个 seed 重新拉） -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/bottomBar"
            app:layout_constraintTop_toBottomOf="@+id/chipBar">

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:listitem="@layout/item_work_1"
                tools:itemCount="3"
                android:scrollbars="vertical"
                android:fadeScrollbars="true"
                android:scrollbarSize="16dp"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 我的 -->
    <ScrollView
            android:id="@+id/mineScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/appBarLayout"
            app:layout_constraintBottom_toTopOf="@+id/bottomBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="24dp">

            <TextView
                    style="@style/Theme.Kikoeru.SettingsGroup"
                    android:paddingStart="8dp"
                    android:text="@string/account"/>

            <LinearLayout style="@style/Theme.Kikoeru.SettingsCard">

                <LinearLayout
                        android:id="@+id/mineAccount"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/account"
                            android:src="@drawable/ic_baseline_people_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/account"/>
                        <TextView
                                android:id="@+id/tvAccount"
                                style="@style/Theme.Kikoeru.SettingsRowSub"
                                tools:text="guest"/>
                    </LinearLayout>

                    <TextView
                            style="@style/Theme.Kikoeru.SettingsRowArrow"
                            android:text="&#8250;"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                    style="@style/Theme.Kikoeru.SettingsGroup"
                    android:paddingStart="8dp"
                    android:text="@string/category"/>

            <LinearLayout style="@style/Theme.Kikoeru.SettingsCard">

                <LinearLayout
                        android:id="@+id/mineCategory"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/category"
                            android:src="@drawable/ic_baseline_category_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/category"/>
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowSub"
                                android:text="@string/category_desc"/>
                    </LinearLayout>

                    <TextView
                            style="@style/Theme.Kikoeru.SettingsRowArrow"
                            android:text="&#8250;"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                    style="@style/Theme.Kikoeru.SettingsGroup"
                    android:paddingStart="8dp"
                    android:text="@string/group_storage"/>

            <LinearLayout style="@style/Theme.Kikoeru.SettingsCard">

                <LinearLayout
                        android:id="@+id/mineDownload"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/download_mission"
                            android:src="@drawable/ic_baseline_download_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/download_mission"/>
                    </LinearLayout>

                    <TextView
                            style="@style/Theme.Kikoeru.SettingsRowArrow"
                            android:text="&#8250;"/>
                </LinearLayout>

                <View style="@style/Theme.Kikoeru.SettingsDivider"/>

                <LinearLayout
                        android:id="@+id/mineHistory"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/local_history"
                            android:src="@drawable/ic_baseline_history_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/local_history"/>
                    </LinearLayout>

                    <TextView
                            style="@style/Theme.Kikoeru.SettingsRowArrow"
                            android:text="&#8250;"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                    style="@style/Theme.Kikoeru.SettingsGroup"
                    android:paddingStart="8dp"
                    android:text="@string/group_others"/>

            <LinearLayout style="@style/Theme.Kikoeru.SettingsCard">

                <LinearLayout
                        android:id="@+id/mineSettings"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/action_settings"
                            android:src="@drawable/ic_baseline_settings_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/action_settings"/>
                    </LinearLayout>

                    <TextView
                            style="@style/Theme.Kikoeru.SettingsRowArrow"
                            android:text="&#8250;"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 播放条 + 底栏 -->
    <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
        <include
                android:id="@+id/bottomLayout"
                layout="@layout/layout_current_play"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"/>
        <LinearLayout
                android:id="@+id/bottomNav"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@color/card_surface"
                android:orientation="horizontal">

            <FrameLayout
                    android:id="@+id/navHome"
                    style="@style/Theme.Kikoeru.NavItem">

                <LinearLayout style="@style/Theme.Kikoeru.NavItemContent">
                    <ImageView
                            android:id="@+id/navHomeIcon"
                            style="@style/Theme.Kikoeru.NavItemIcon"
                            android:contentDescription="@string/home"
                            android:src="@drawable/ic_baseline_widgets_24"/>
                    <TextView
                            android:id="@+id/navHomeLabel"
                            style="@style/Theme.Kikoeru.NavItemLabel"
                            android:text="@string/home"/>
                </LinearLayout>

                <View
                        android:id="@+id/navHomeIndicator"
                        style="@style/Theme.Kikoeru.NavIndicator"
                        android:layout_gravity="top|center_horizontal"/>
            </FrameLayout>

            <FrameLayout
                    android:id="@+id/navFavourites"
                    style="@style/Theme.Kikoeru.NavItem">

                <LinearLayout style="@style/Theme.Kikoeru.NavItemContent">
                    <ImageView
                            android:id="@+id/navFavIcon"
                            style="@style/Theme.Kikoeru.NavItemIcon"
                            android:contentDescription="@string/favourites"
                            android:src="@drawable/ic_baseline_favorite_24"/>
                    <TextView
                            android:id="@+id/navFavLabel"
                            style="@style/Theme.Kikoeru.NavItemLabel"
                            android:text="@string/favourites"/>
                </LinearLayout>

                <View
                        android:id="@+id/navFavIndicator"
                        style="@style/Theme.Kikoeru.NavIndicator"
                        android:layout_gravity="top|center_horizontal"/>
            </FrameLayout>

            <FrameLayout
                    android:id="@+id/navMine"
                    style="@style/Theme.Kikoeru.NavItem">

                <LinearLayout style="@style/Theme.Kikoeru.NavItemContent">
                    <ImageView
                            android:id="@+id/navMineIcon"
                            style="@style/Theme.Kikoeru.NavItemIcon"
                            android:contentDescription="@string/mine"
                            android:src="@drawable/ic_baseline_people_24"/>
                    <TextView
                            android:id="@+id/navMineLabel"
                            style="@style/Theme.Kikoeru.NavItemLabel"
                            android:text="@string/mine"/>
                </LinearLayout>

                <View
                        android:id="@+id/navMineIndicator"
                        style="@style/Theme.Kikoeru.NavIndicator"
                        android:layout_gravity="top|center_horizontal"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
            android:id="@+id/llNetErr"
            android:visibility="gone"
            android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:gravity="center"
                  android:orientation="vertical" app:layout_constraintTop_toBottomOf="@+id/appBarLayout"
                  app:layout_constraintBottom_toTopOf="@+id/bottomBar">
        <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/high_priority_svgrepo_com"
                android:id="@+id/imageView5"
                />
        <TextView android:id="@+id/tvNetErr" android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="Network err"
                  android:textSize="16sp"
                  android:layout_marginTop="8dp"
                  android:gravity="center_horizontal"/>
        <Button android:id="@+id/btRetry" android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Retry"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>