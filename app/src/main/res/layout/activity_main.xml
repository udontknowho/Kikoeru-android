<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WorksActivity">

    <com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent"
                                                     android:layout_height="wrap_content"
                                                     app:layout_constraintStart_toStartOf="parent"
                                                     app:layout_constraintEnd_toEndOf="parent"
                                                     app:layout_constraintTop_toTopOf="parent"
                                                     android:background="?attr/colorSurface"
                                                     android:id="@+id/appBarLayout">
        <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/Theme.Kikoeru.Toolbar"
                />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 收藏 tab 的状态筛选（只在该 tab 显示） -->
    <HorizontalScrollView
            android:id="@+id/chipBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:scrollbars="none"
            android:background="?attr/colorSurface"
            app:layout_constraintTop_toBottomOf="@+id/appBarLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="true">
            <com.google.android.material.chip.Chip
                    android:id="@+id/chipReview"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/review"/>
            <com.google.android.material.chip.Chip
                    android:id="@+id/chipMarked"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/marked"/>
            <com.google.android.material.chip.Chip
                    android:id="@+id/chipListening"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/listening"/>
            <com.google.android.material.chip.Chip
                    android:id="@+id/chipListened"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/listened"/>
            <com.google.android.material.chip.Chip
                    android:id="@+id/chipReplay"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/replay"/>
            <com.google.android.material.chip.Chip
                    android:id="@+id/chipPostponed"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/postponed"/>
            <com.google.android.material.chip.Chip
                    android:id="@+id/chipLocal"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/local_works"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- 列表（下拉刷新 = 换一批：换一个 seed 重新拉） -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/bottomBar"
            app:layout_constraintTop_toBottomOf="@+id/chipBar">

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:listitem="@layout/item_work_1"
                tools:itemCount="3"
                android:scrollbars="vertical"
                android:fadeScrollbars="true"
                android:scrollbarSize="16dp"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 我的 -->
    <ScrollView
            android:id="@+id/mineScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/appBarLayout"
            app:layout_constraintBottom_toTopOf="@+id/bottomBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <RelativeLayout
                    android:id="@+id/mineAccount"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/item_bg">
                <TextView
                        android:id="@+id/tvAccount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="20dp"
                        android:drawableStart="@drawable/ic_baseline_people_24"
                        android:drawableTint="@color/black"
                        android:text="@string/account"
                        android:textSize="16sp"/>
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="20dp"
                        android:text="&#8250;"
                        android:textSize="20sp"/>
            </RelativeLayout>
            <RelativeLayout
                    android:id="@+id/mineCategory"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/item_bg">
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="20dp"
                        android:drawableStart="@drawable/ic_baseline_category_24"
                        android:drawablePadding="16dp"
                        android:drawableTint="@color/black"
                        android:text="@string/category"
                        android:textSize="16sp"/>
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="20dp"
                        android:text="&#8250;"
                        android:textSize="20sp"/>
            </RelativeLayout>
            <RelativeLayout
                    android:id="@+id/mineDownload"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/item_bg">
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="20dp"
                        android:drawableStart="@drawable/ic_baseline_storage_24"
                        android:drawableTint="@color/black"
                        android:text="@string/download_mission"
                        android:textSize="16sp"/>
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="20dp"
                        android:text="&#8250;"
                        android:textSize="20sp"/>
            </RelativeLayout>
            <RelativeLayout
                    android:id="@+id/mineHistory"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/item_bg">
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="20dp"
                        android:drawableStart="@drawable/ic_baseline_loop_main_24"
                        android:drawableTint="@color/black"
                        android:text="@string/local_history"
                        android:textSize="16sp"/>
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="20dp"
                        android:text="&#8250;"
                        android:textSize="20sp"/>
            </RelativeLayout>
            <RelativeLayout
                    android:id="@+id/mineSettings"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/item_bg">
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="20dp"
                        android:drawableStart="@drawable/ic_baseline_settings_24"
                        android:drawableTint="@color/black"
                        android:text="@string/action_settings"
                        android:textSize="16sp"/>
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="20dp"
                        android:text="&#8250;"
                        android:textSize="20sp"/>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 播放条 + 底栏 -->
    <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
        <include
                android:id="@+id/bottomLayout"
                layout="@layout/layout_current_play"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"/>
        <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorPrimaryVariant"
                android:elevation="10dp"
                app:itemIconTint="@color/nav_item_color"
                app:itemTextColor="@color/nav_item_color"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/bottom_nav"/>
    </LinearLayout>
    <LinearLayout
            android:id="@+id/llNetErr"
            android:visibility="gone"
            android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:gravity="center"
                  android:orientation="vertical" app:layout_constraintTop_toBottomOf="@+id/appBarLayout"
                  app:layout_constraintBottom_toTopOf="@+id/bottomBar">
        <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/high_priority_svgrepo_com"
                android:id="@+id/imageView5"
                />
        <TextView android:id="@+id/tvNetErr" android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="Network err"
                  android:textSize="16sp"
                  android:layout_marginTop="8dp"
                  android:gravity="center_horizontal"/>
        <Button android:id="@+id/btRetry" android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Retry"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>