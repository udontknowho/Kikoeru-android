<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   android:layout_width="match_parent"
                                                   xmlns:tools="http://schemas.android.com/tools"
                                                   android:background="@drawable/card_bg_current_play"
                                                   android:paddingRight="15dp"
                                                   android:paddingLeft="15dp"
                                                   android:paddingBottom="15dp"
                                                   android:layout_gravity="bottom"
                                                   android:layout_height="wrap_content">

    <ImageView
            android:id="@+id/imageView"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="15dp"
            android:src="@drawable/ic_no_cover"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>

    <TextView
            android:id="@+id/textView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="title \ntitle"
            android:textColor="@color/ink_primary"
            android:maxLines="1"
            android:textSize="15sp"
            app:layout_constraintStart_toEndOf="@+id/imageView"
            app:layout_constraintTop_toTopOf="@+id/imageView" app:layout_constraintEnd_toStartOf="@+id/imageButton"/>

    <TextView
            android:id="@+id/textView2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="subtitle"
            android:maxLines="1"
            android:textColor="@color/ink_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toBottomOf="@+id/imageView"
            app:layout_constraintStart_toEndOf="@+id/imageView" app:layout_constraintEnd_toStartOf="@+id/imageButton"/>

    <ImageButton
        android:id="@+id/button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="play or pause"
        android:tint="@color/icon_tint"
        android:src="@drawable/ic_baseline_play_arrow_24"
        app:contentDescription="play or pause"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textView" />

    <ImageButton
            android:id="@+id/imageButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="visible"
            android:tint="@color/icon_tint"
            android:src="@drawable/ic_baseline_text_fields_24"
            android:contentDescription="lrc_display"
            app:layout_constraintEnd_toStartOf="@+id/button" app:layout_constraintTop_toTopOf="@+id/button"
            app:layout_constraintBottom_toBottomOf="@+id/button"/>
</androidx.constraintlayout.widget.ConstraintLayout>