<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical"
    tools:context=".MoreActivity">

    <com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent"
                                                     android:layout_height="wrap_content"
                                                     app:layout_constraintStart_toStartOf="parent"
                                                     app:layout_constraintEnd_toEndOf="parent"
                                                     app:layout_constraintTop_toTopOf="parent"
                                                     android:background="@color/screen_bg"
                                                     android:id="@+id/appBarLayout">
        <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/Theme.Kikoeru.Toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

        <LinearLayout android:id="@+id/content"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_marginStart="12dp"
                      android:layout_marginEnd="12dp"
                      android:orientation="vertical"
                      android:paddingBottom="28dp">

            <!-- ==================== 外观 ==================== -->
            <TextView
                    style="@style/Theme.Kikoeru.SettingsGroup"
                    android:paddingStart="8dp"
                    android:text="@string/group_appearance"/>

            <LinearLayout
                    style="@style/Theme.Kikoeru.SettingsCard">

                <LinearLayout
                        android:id="@+id/themeRow"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/theme_mode"
                            android:src="@drawable/ic_baseline_light_mode_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/theme_mode"/>
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowSub"
                                android:text="@string/theme_mode_desc"/>
                    </LinearLayout>

                    <TextView
                            android:id="@+id/tvThemeMode"
                            style="@style/Theme.Kikoeru.SettingsRowStatus"
                            tools:text="跟随系统"/>

                    <TextView
                            style="@style/Theme.Kikoeru.SettingsRowArrow"
                            android:text="&#8250;"/>
                </LinearLayout>

                <View style="@style/Theme.Kikoeru.SettingsDivider"/>

                <LinearLayout
                        android:id="@+id/rlHomeTab"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/new_home_layout"
                            android:src="@drawable/ic_baseline_view_column_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/new_home_layout"/>
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowSub"
                                android:text="@string/new_home_layout_desc"/>
                    </LinearLayout>

                    <CheckBox
                            android:id="@+id/cbHomeTab"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""/>
                </LinearLayout>
            </LinearLayout>

            <!-- ==================== 服务器 ==================== -->
            <TextView
                    style="@style/Theme.Kikoeru.SettingsGroup"
                    android:paddingStart="8dp"
                    android:text="@string/group_server"/>

            <LinearLayout
                    style="@style/Theme.Kikoeru.SettingsCard">

                <LinearLayout
                        android:id="@+id/switchServer"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/switch_server"
                            android:src="@drawable/ic_baseline_swap_horiz_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/switch_server"/>
                        <TextView
                                android:id="@+id/tvServerName"
                                style="@style/Theme.Kikoeru.SettingsRowSub"
                                tools:text="asmr.unikon.art"/>
                    </LinearLayout>

                    <TextView
                            style="@style/Theme.Kikoeru.SettingsRowArrow"
                            android:text="&#8250;"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ==================== 播放与字幕 ==================== -->
            <TextView
                    style="@style/Theme.Kikoeru.SettingsGroup"
                    android:paddingStart="8dp"
                    android:text="@string/group_playback"/>

            <LinearLayout
                    style="@style/Theme.Kikoeru.SettingsCard">

                <LinearLayout
                        android:id="@+id/relativeLayout"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/only_load_has_lrc"
                            android:src="@drawable/ic_baseline_text_fields_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/only_load_has_lrc"/>
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowSub"
                                android:text="@string/only_load_has_lrc_desc"/>
                    </LinearLayout>

                    <CheckBox
                            android:id="@+id/checkBox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""/>
                </LinearLayout>

                <View style="@style/Theme.Kikoeru.SettingsDivider"/>

                <LinearLayout
                        android:id="@+id/lrcSize"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/lrc_text_size"
                            android:src="@drawable/ic_baseline_format_size_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/lrc_text_size"/>
                    </LinearLayout>

                    <TextView
                            android:id="@+id/tvLrcSize"
                            style="@style/Theme.Kikoeru.SettingsRowStatus"
                            tools:text="36sp"/>

                    <TextView
                            style="@style/Theme.Kikoeru.SettingsRowArrow"
                            android:text="&#8250;"/>
                </LinearLayout>

                <View style="@style/Theme.Kikoeru.SettingsDivider"/>

                <LinearLayout
                        android:id="@+id/lrcColor"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/lrc_text_color"
                            android:src="@drawable/ic_baseline_palette_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/lrc_text_color"/>
                    </LinearLayout>

                    <TextView
                            android:id="@+id/tvLrcColor"
                            style="@style/Theme.Kikoeru.SettingsRowStatus"
                            tools:text="#FFFFFF"/>

                    <TextView
                            style="@style/Theme.Kikoeru.SettingsRowArrow"
                            android:text="&#8250;"/>
                </LinearLayout>

                <View style="@style/Theme.Kikoeru.SettingsDivider"/>

                <LinearLayout
                        android:id="@+id/lrcAlpha"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/lrc_text_alpha"
                            android:src="@drawable/ic_baseline_opacity_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/lrc_text_alpha"/>
                    </LinearLayout>

                    <TextView
                            android:id="@+id/tvLrcAlpha"
                            style="@style/Theme.Kikoeru.SettingsRowStatus"
                            tools:text="100%"/>

                    <TextView
                            style="@style/Theme.Kikoeru.SettingsRowArrow"
                            android:text="&#8250;"/>
                </LinearLayout>

                <View style="@style/Theme.Kikoeru.SettingsDivider"/>

                <LinearLayout
                        android:id="@+id/lrcBg"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/lrc_text_bg"
                            android:src="@drawable/ic_baseline_layers_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/lrc_text_bg"/>
                    </LinearLayout>

                    <TextView
                            android:id="@+id/tvLrcBg"
                            style="@style/Theme.Kikoeru.SettingsRowStatus"
                            tools:text="无"/>

                    <TextView
                            style="@style/Theme.Kikoeru.SettingsRowArrow"
                            android:text="&#8250;"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ==================== 下载与存储 ==================== -->
            <TextView
                    style="@style/Theme.Kikoeru.SettingsGroup"
                    android:paddingStart="8dp"
                    android:text="@string/group_storage"/>

            <LinearLayout
                    style="@style/Theme.Kikoeru.SettingsCard">

                <LinearLayout
                        android:id="@+id/saveExternal"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/saveAtExternal"
                            android:src="@drawable/ic_baseline_storage_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/saveAtExternal"/>
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowSub"
                                android:text="@string/save_at_external_desc"/>
                    </LinearLayout>

                    <CheckBox
                            android:id="@+id/checkBox3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""/>
                </LinearLayout>
            </LinearLayout>

            <!-- ==================== 代理 ==================== -->
            <TextView
                    style="@style/Theme.Kikoeru.SettingsGroup"
                    android:paddingStart="8dp"
                    android:text="@string/group_network"/>

            <LinearLayout
                    style="@style/Theme.Kikoeru.SettingsCard">

                <LinearLayout
                        android:id="@+id/proxySwitch"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/proxy_enabled"
                            android:src="@drawable/ic_baseline_loop_main_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/proxy_enabled"/>
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowSub"
                                android:text="@string/proxy_desc"/>
                    </LinearLayout>

                    <CheckBox
                            android:id="@+id/cbProxy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""/>
                </LinearLayout>

                <View style="@style/Theme.Kikoeru.SettingsDivider"/>

                <LinearLayout
                        android:id="@+id/proxyAddr"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/proxy_addr"
                            android:src="@drawable/ic_baseline_language_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/proxy_addr"/>
                    </LinearLayout>

                    <TextView
                            android:id="@+id/tvProxyAddr"
                            style="@style/Theme.Kikoeru.SettingsRowStatus"
                            tools:text="127.0.0.1:7890"/>

                    <TextView
                            style="@style/Theme.Kikoeru.SettingsRowArrow"
                            android:text="&#8250;"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ==================== 隐私与安全 ==================== -->
            <TextView
                    style="@style/Theme.Kikoeru.SettingsGroup"
                    android:paddingStart="8dp"
                    android:text="@string/group_privacy"/>

            <LinearLayout
                    style="@style/Theme.Kikoeru.SettingsCard">

                <LinearLayout
                        android:id="@+id/appLock"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/app_lock"
                            android:src="@drawable/ic_baseline_lock_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/app_lock"/>
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowSub"
                                android:text="@string/app_lock_desc"/>
                    </LinearLayout>

                    <CheckBox
                            android:id="@+id/cbAppLock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""/>
                </LinearLayout>
            </LinearLayout>

            <!-- ==================== 其他 ==================== -->
            <TextView
                    style="@style/Theme.Kikoeru.SettingsGroup"
                    android:paddingStart="8dp"
                    android:text="@string/group_others"/>

            <LinearLayout
                    style="@style/Theme.Kikoeru.SettingsCard">

                <LinearLayout
                        android:id="@+id/license"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/opensource_license"
                            android:src="@drawable/ic_baseline_description_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/opensource_license"/>
                    </LinearLayout>

                    <TextView
                            style="@style/Theme.Kikoeru.SettingsRowArrow"
                            android:text="&#8250;"/>
                </LinearLayout>

                <View style="@style/Theme.Kikoeru.SettingsDivider"/>

                <LinearLayout
                        android:id="@+id/debug"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/debug_mode"
                            android:src="@drawable/ic_baseline_bug_report_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/debug_mode"/>
                    </LinearLayout>

                    <CheckBox
                            android:id="@+id/checkBox1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""/>
                </LinearLayout>

                <View style="@style/Theme.Kikoeru.SettingsDivider"/>

                <LinearLayout
                        android:id="@+id/about"
                        style="@style/Theme.Kikoeru.SettingsRow">

                    <ImageView
                            style="@style/Theme.Kikoeru.SettingsRowIcon"
                            android:contentDescription="@string/about"
                            android:src="@drawable/ic_baseline_info_24"/>

                    <LinearLayout style="@style/Theme.Kikoeru.SettingsRowMid">
                        <TextView
                                style="@style/Theme.Kikoeru.SettingsRowTitle"
                                android:text="@string/about"/>
                    </LinearLayout>

                    <TextView
                            style="@style/Theme.Kikoeru.SettingsRowArrow"
                            android:text="&#8250;"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
