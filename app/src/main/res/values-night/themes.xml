<resources>
    <!-- Base application theme. -->
    <style name="Theme.Kikoeru" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent</item>
        <item name="colorOnPrimary">@color/screen_bg</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent</item>
        <item name="android:colorBackground">@color/screen_bg</item>
        <item name="android:windowBackground">@color/screen_bg</item>

        <item name="colorSecondaryVariant">@color/green</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" >@color/screen_bg</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:navigationBarColor">@color/screen_bg</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Customize your theme here. -->
        <item name="android:textColorPrimary">@color/ink_primary</item>
        <item name="colorSurface">@color/card_surface</item>
        <item name="colorOnSurface">@color/ink_primary</item>
    </style>

    <style name="Theme.Kikoeru.TextInputStyle">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="RoundedAlertDialog" parent="Base.RoundedAlertDialog">
        <!-- 可选：设置标题样式 -->
        <item name="android:textColorPrimary">@color/white</item>
    </style>
    <style name="NegativeButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/white</item>
    </style>
</resources>